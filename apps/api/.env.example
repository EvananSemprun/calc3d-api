# Conexión a PostgreSQL (ajustar usuario/clave/host/puerto/base)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/calc3d?schema=public"

# Secreto para firmar los JWT (cambiar por uno largo y aleatorio)
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# Puerto del API
PORT=3000

# Origen permitido para CORS (frontend)
WEB_ORIGIN="http://localhost:5173"

# ----- Tienda (catálogo público) -----
# Organización cuyo catálogo sirve /api/public/store/*. Sin esto, la tienda
# responde "no configurada": la organización NUNCA se toma de un parámetro del
# cliente, porque eso permitiría pedir los datos de cualquier otra.
STORE_ORGANIZATION_ID=""
# Origen del front de la tienda, para CORS (admite lista separada por comas).
STORE_ORIGIN="http://localhost:5182"

# ----- Fotos del catálogo (Cloudflare R2, compatible con S3) -----
# Sin estas variables la app arranca igual, pero la carga de fotos queda
# deshabilitada y el panel lo avisa.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="calc3d-store"
# URL pública del bucket (subdominio r2.dev o dominio propio), sin barra final.
R2_PUBLIC_URL=""
