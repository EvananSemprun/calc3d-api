// Schema de Prisma para Calc3D.
// Multi-tenant: cada catálogo y presupuesto pertenece a una Organization.
// Dinero como Decimal(12,4) (sub-centavo); el motor de cálculo usa decimal.js.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  COLLABORATOR
}

// Tipo de contacto en el directorio/CRM (Fase 5). CLIENT es el default para no
// romper los clientes existentes; SUPPLIER/ALLY/COMPETITOR se activan en la UI.
enum ContactType {
  CLIENT
  SUPPLIER
  ALLY
  COMPETITOR
}

// Venta: COUNTER = mostrador/venta directa, ENCARGO = pedido personalizado.
enum SaleKind {
  COUNTER
  ENCARGO
}

// Categorías de gasto general (la impresora es EQUIPMENT + isInvestment).
enum ExpenseCategory {
  EQUIPMENT
  CONSUMABLE
  MAINTENANCE
  SHIPPING
  OTHER
  ADVERTISING
  // Diseño (el diseñador de las imágenes y piezas). Va aparte de OTHER porque
  // lo paga el propietario de su sueldo y es la primera línea que el negocio
  // le devuelve.
  DESIGN
}

/// Movimiento de plata PURA entre el bolsillo del propietario y la caja, que
/// no es un gasto: sacar plata del negocio para él o meter plata suya sin
/// comprar nada. Las compras que el propietario paga NO van acá: van como
/// gasto con su contraparte, o se cargarían dos veces (que es lo que
/// descuadraba la hoja Caja).
enum OwnerMovementKind {
  CONTRIBUTION
  WITHDRAWAL
}

/// Qué es una contraparte respecto del negocio. Un socio y el dueño se tratan
/// igual (ponen plata y se les debe); un prestamista externo no participa.
/// Cada cuánto se propone pagar una cuota. Es el período del OBJETIVO, no una
/// promesa al acreedor: los pagos reales pueden ser irregulares.
enum PaymentFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum CounterpartyKind {
  OWNER
  PARTNER
  EXTERNAL_LENDER
}

enum CashAccountKind {
  EXCHANGE
  BANK
  CASH
  WALLET
  OTHER
}

enum ReconciliationStatus {
  DRAFT
  CONFIRMED
  VOID
}

/// De dónde salió un registro. `EXCEL_IMPORT` es la etiqueta "Importado";
/// `RECONCILIATION` marca los ajustes que generó una conciliación.
enum RecordSource {
  MANUAL
  EXCEL_IMPORT
  RECONCILIATION
  MIGRATION
}

/// Contra qué deuda se aplica primero un pago a la contraparte.
enum DebtApplicationOrder {
  OLDEST_FIRST
  NEWEST_FIRST
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members         Membership[]
  settings        Settings?
  materials       Material[]
  stockCounts     StockCount[]
  stockMonths     StockMonth[]
  printers        Printer[]
  components      Component[]
  clients         Client[]
  sales           Sale[]
  expenses        Expense[]
  exchangeRates   ExchangeRate[]
  ownerMovements  OwnerMovement[]
  orders          Order[]
  catalogOptions  CatalogOption[]
  storeProducts   StoreProduct[]
  storeCategories StoreCategory[]
  campaigns       Campaign[]
  storeRequests   StoreRequest[]
  loans           Loan[]
  loanPayments    LoanPayment[]
  goals           Goal[]
  printerReadings PrinterReading[]

  counterparties   Counterparty[]
  cashAccounts     CashAccount[]
  reconciliations  CashReconciliation[]
  debtApplications DebtApplication[]
  purchaseInvoices PurchaseInvoice[]
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  createdAt     DateTime       @default(now())
  memberships   Membership[]
  refreshTokens RefreshToken[]
  authTokens    AuthToken[]

  confirmedReconciliations CashReconciliation[]
}

// Propósito de un token de un solo uso enviado por correo.
enum AuthTokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// Refresh token rotatorio persistido (revocable). Se guarda el HASH (sha256),
// nunca el token en claro. `family` agrupa la cadena de rotaciones de un login;
// si un token ya revocado se reusa, se revoca toda la familia (posible robo).
model RefreshToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  family    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([family])
}

// Token de un solo uso para verificar email o restablecer contraseña. Se guarda
// el HASH; expira y se marca `usedAt` al consumirse.
model AuthToken {
  id        String           @id @default(cuid())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String           @unique
  purpose   AuthTokenPurpose
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
}

model Membership {
  id             String       @id @default(cuid())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  role           Role         @default(OWNER)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// Configuración global del usuario/negocio. Valores por defecto sensatos.
model Settings {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String       @unique

  currency            String  @default("USD")
  locale              String  @default("en-US")
  secondaryCurrency   String? @default("VES") // (legado) moneda secundaria; el default vivo es defaultRateLabel
  // Tasa con NOMBRE usada por defecto en la vista ambiental (RateBadge, monto dual
  // en vivo). null = mostrar solo USD. Los documentos pueden elegir otra.
  defaultRateLabel    String?
  // Tasa con NOMBRE de REFERENCIA para proteger el margen al cobrar en bolívares
  // (el "dólar real", típicamente el paralelo/Binance). Define los bolívares
  // objetivo a recibir. null = usar el default de la app (Binance/USDT).
  protectionRateLabel String?
  kwhPrice            Decimal @default(0) @db.Decimal(12, 4)
  defaultWastePct     Float   @default(0.08)
  // Margen objetivo por defecto (markup sobre el costo, fracción: 1.0 = 100 %).
  // Reemplaza a `defaultMargins`: desde shared 0.7.0 la calculadora trabaja con
  // UN margen, no con tres precios a elegir.
  defaultMarkup       Float   @default(1.0)
  // Piso de margen real: bajo esto la calculadora avisa en rojo (no bloquea).
  // Es el error que más caro sale, así que no se baja el precio en silencio.
  minMarginPct        Float   @default(0.6)
  roundingMode        String  @default("NONE") // NONE | NEAREST | UP | DOWN
  roundingIncrement   Float   @default(1)
  taxPercent          Float? // reservado para fase 2 (IVA)

  // Costos fijos mensuales (alquiler, internet, luz base…) como lista JSON
  // [{ concept, monthlyAmount }] y el margen de contribución para el punto de
  // equilibrio (fracción, 0.4 = 40 %). Solo se usan para análisis en el dashboard;
  // NO entran en el precio por pieza.
  fixedCosts         Json  @default("[]")
  breakEvenMarginPct Float @default(0.4)
  /// Nivel 3 del punto de equilibrio: lo que se quiere apartar cada mes para
  /// reponer los equipos. La cuota del préstamo NO va acá: se deriva de los
  /// préstamos abiertos, o el mismo número en dos lugares termina divergiendo.
  equipmentReserve   Float @default(0)

  // Datos del negocio para la nota de entrega (el nombre sale de Organization).
  businessRif     String?
  businessPhone   String?
  businessAddress String?
  businessSigner  String? // nombre de quien firma la entrega
  // Logo del negocio para el encabezado de los documentos (nota de entrega y
  // cotización). Se guarda en la BD y NO en disco: el hosting de la API tiene
  // disco efímero (se pierde en cada despliegue).
  // Solo PNG/JPEG (pdfkit no dibuja SVG) y con tope de tamaño en el endpoint.
  logo            Bytes?
  logoMime        String?

  // Piso de margen (markup, fracción) bajo el cual un producto del catálogo
  // dispara alerta de rentabilidad al recostear con precios/tasa de hoy.
  productAlertMinMarginPct Float @default(0.15)

  /// Frecuencia SUGERIDA de conciliación. Es un recordatorio y una etiqueta:
  /// NO bloquea conciliar cualquier día.
  reconciliationFrequency String               @default("WEEKLY") // NONE | WEEKLY | BIWEEKLY | MONTHLY
  /// 1 = lunes … 7 = domingo. Solo aplica con WEEKLY/BIWEEKLY.
  reconciliationWeekday   Int?                 @default(1)
  debtApplicationOrder    DebtApplicationOrder @default(OLDEST_FIRST)
}

/// Si el color se sigue comprando o se decidió no reponerlo más. Un
/// descontinuado NO entra en la lista de reposición aunque llegue a cero.
enum MaterialStatus {
  ACTIVE
  DISCONTINUED
}

model Material {
  id             String         @id @default(cuid())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  type           String?
  brand          String?
  rollPrice      Decimal        @db.Decimal(12, 4)
  rollGrams      Int            @default(1000)
  color          String?
  status         MaterialStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())

  expenses    Expense[]
  stockCounts StockCount[]
  /// Las líneas de factura que piden este filamento.
  purchaseLines PurchaseInvoiceLine[]

  @@index([organizationId])
}

/// Conteo FÍSICO de rollos al cierre de mes (hoja "Stock mensual" del Excel).
/// El total NO se guarda: se deriva de las tres partes con `stockTotal`, para
/// que no pueda contradecir a sus partes.
model StockCount {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  material       Material     @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId     String

  /// Mes contado, como el primer día del mes a medianoche UTC.
  month   DateTime
  sealed  Int      @default(0) // sin abrir
  inUse   Int      @default(0) // abierto, con material
  running Int      @default(0) // por acabarse (menos de un cuarto)

  /// El conteo se importó del Excel sin saber la marca del rollo. Se apaga al
  /// moverlo al material correcto.
  needsBrandCheck Boolean  @default(false)
  countedAt       DateTime @default(now())

  @@unique([materialId, month])
  @@index([organizationId, month])
}

/// Cierre del conteo físico de un mes. Un mes SIN fila está abierto (nunca se
/// cerró). Cerrar es la única forma de escribir conteos; corregir exige reabrir.
model StockMonth {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  /// Mes, como el primer día a medianoche UTC (igual que StockCount.month).
  month      DateTime
  /// null = abierto.
  closedAt   DateTime?
  /// Última reapertura. Se conserva al volver a cerrar: es el rastro de la corrección.
  reopenedAt DateTime?

  @@unique([organizationId, month])
}

model Printer {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  price          Decimal      @db.Decimal(12, 4)
  lifetimeHours  Int          @default(5000)
  powerKw        Decimal      @default(0) @db.Decimal(12, 4)
  maintPerHour   Decimal      @default(0) @db.Decimal(12, 4)
  createdAt      DateTime     @default(now())

  expenses Expense[]
  loans    Loan[]
  orders   Order[]
  readings PrinterReading[]
  /// Las líneas de factura que piden esta impresora.
  purchaseLines PurchaseInvoiceLine[]

  @@index([organizationId])
}

model Component {
  id              String       @id @default(cuid())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId  String
  name            String
  packagePrice    Decimal      @db.Decimal(12, 4)
  unitsPerPackage Int
  scope           String       @default("PER_PIECE") // PER_PIECE | PER_ORDER
  createdAt       DateTime     @default(now())

  expenses Expense[]

  @@index([organizationId])
}

model Client {
  id             String         @id @default(cuid())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  contact        String?
  // Tipo de contacto en el directorio/CRM (Fase 5). Default CLIENT.
  type           ContactType    @default(CLIENT)
  // Datos opcionales (nota de entrega, futuro CRM/mapa). El flujo rápido de
  // WhatsApp solo exige nombre + teléfono.
  phone          String?
  rif            String?
  address        String?
  municipality   String?
  city           String?
  notes          String?
  // Ubicación en el mapa (se fija haciendo click en el mapa; sin geocodificación).
  lat            Float?
  lng            Float?
  createdAt      DateTime       @default(now())
  sales          Sale[]
  orders         Order[]
  storeRequests  StoreRequest[]
  /// Los gastos en los que este contacto es el proveedor.
  expensesAsProvider Expense[] @relation("GastosDelProveedor")
  /// Las facturas de compra que le comprás a este contacto.
  purchaseInvoices   PurchaseInvoice[] @relation("FacturasDelProveedor")

  @@index([organizationId])
  @@index([organizationId, type])
}

// Un presupuesto guarda un SNAPSHOT del CalcInput y de los totales calculados,
// para integridad histórica de precios (no cambia si luego editas un catálogo).

// Venta registrada (transacción individual). El total del día/periodo se agrega
// al vuelo. Se registra a mano o desde la operación del día.
model Sale {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId       String?

  date   DateTime
  amount Decimal  @db.Decimal(12, 4)
  kind   SaleKind @default(COUNTER)
  note   String?

  exchangeRates Json? // snapshot de tasas al registrar la venta

  /// De dónde salió este registro. `EXCEL_IMPORT` es la insignia "Importado"
  /// del desplegable de la Caja: sin ella, las ventas que vinieron del Excel se
  /// verían como si las hubiera cargado el dueño a mano.
  source RecordSource @default(MANUAL)

  // Atribución de publicidad (Fase 1). null = "Sin atribuir".
  originChannel AttributionChannel?
  campaign      Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId    String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, date])
  @@index([campaignId])
}

// Ledger ÚNICO de dinero que sale (gastos, inversiones, compras de insumos).
// Enlace OPCIONAL a un item de catálogo (impresora/material/componente/empaque):
// la identidad vive en el catálogo, el gasto solo guarda el evento (monto, fecha,
// cantidad). Un catálogo ↔ muchos gastos (compra inicial + recompras/mantenimientos).
model Expense {
  id             String          @id @default(cuid())
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  date           DateTime
  category       ExpenseCategory @default(OTHER)
  description    String
  amount         Decimal         @db.Decimal(12, 4)
  isInvestment   Boolean         @default(false)
  quantity       Int? // unidades/rollos comprados (consumibles)
  endDate        DateTime? // fin del período (p. ej. publicidad: de `date` a `endDate`)

  // Enlace polimórfico opcional al catálogo (solo uno por fila).
  material    Material?  @relation(fields: [materialId], references: [id], onDelete: SetNull)
  materialId  String?
  printer     Printer?   @relation(fields: [printerId], references: [id], onDelete: SetNull)
  printerId   String?
  component   Component? @relation(fields: [componentId], references: [id], onDelete: SetNull)
  componentId String?

  /// A QUIÉN le compraste. Es un contacto del directorio, no una tabla aparte.
  ///
  /// ⚠️ Hasta 2026-10-09 apuntaba a una tabla `Provider` propia, con nombre y
  /// teléfono y nada más, y el directorio tenía su propio tipo "Proveedor":
  /// dos lugares para la misma cosa que no se hablaban. La migración copió la
  /// única fila CONSERVANDO SU id, así que ninguna llave quedó colgando.
  provider   Client? @relation("GastosDelProveedor", fields: [providerId], references: [id], onDelete: SetNull)
  providerId String?

  // Publicidad (Fase 1): un gasto ADVERTISING puede enlazar a una campaña. La tasa
  // Bs se congela aquí si el gasto se pagó en bolívares (amount sigue en USD base).
  campaign     Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId   String?
  rate         Decimal?  @db.Decimal(18, 6)
  currencyCode String?

  /// De qué línea de factura nació esta compra. `null` = se cargó directo.
  ///
  /// ⚠️ **Es lo que le dice a Caja que su plata YA se contó.** Un gasto nacido
  /// de una factura no mueve el saldo: lo movieron los abonos de la factura.
  /// Sin esto, abonar $50 y después recibir la compra de $50 bajaría el saldo
  /// $100 — el mismo error que descuadraba la hoja del Excel.
  purchaseInvoiceLine   PurchaseInvoiceLine? @relation(fields: [purchaseInvoiceLineId], references: [id], onDelete: SetNull)
  purchaseInvoiceLineId String?

  /// QUIÉN PUSO LA PLATA. `null` = la caja del negocio.
  ///
  /// La cuenta de Binance mezcla la plata del negocio con la personal; sin este
  /// dato la caja no se puede reconstruir. Es a quien se le DEBE lo que puso.
  ///
  /// ⚠️ Hasta la migración `20261010100000_adios_paidby` esto convivía con un enum `paidBy`
  /// (BUSINESS/OWNER/LOAN) que no distinguía socios: con dos personas poniendo
  /// plata, los gastos de ambas se mezclaban y cada una veía como propia la
  /// deuda de la otra.
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  counterpartyId String?

  /// Si lo pagó la contraparte: ¿se le devuelve, o fue aporte de capital?
  /// Default `true` para no alterar el histórico. Solo se lee si hay contraparte.
  refundable Boolean      @default(true)
  source     RecordSource @default(MANUAL)

  debtApplications DebtApplication[]

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, date])
  @@index([campaignId])
  @@index([purchaseInvoiceLineId])
}

enum ExchangeRateSource {
  AUTO
  MANUAL
}

// Estado del pedido a lo largo de su vida (encargo → entrega).
enum OrderStatus {
  QUOTED
  CONFIRMED
  IN_PRODUCTION
  READY
  DELIVERED
  CANCELLED
}

// Pedido (encargo): saca el trabajo de WhatsApp. Las líneas viven como JSON
// [{ description, quantity, unit, unitPrice }] (no se consultan por separado);
// los abonos son filas propias. El SALDO se DERIVA (total de líneas − abonos),
// no se almacena, para no quedar obsoleto. Congela snapshot de tasas para Bs.
model Order {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  clientId       String

  code          Int // correlativo por organización (para la nota de entrega)
  deliveryDate  DateTime?
  status        OrderStatus @default(QUOTED)
  notes         String?
  lines         Json        @default("[]")
  currencyLabel String? // moneda de presentación elegida (null = solo USD)
  exchangeRates Json?
  // Cierre en bolívares (Fase 2): mientras es null, los Bs se muestran EN VIVO
  // (tasa de hoy para `currencyLabel`); al emitir la nota de entrega se re-congela
  // `exchangeRates` a la tasa del momento y se marca `settledAt` (Bs finales).
  settledAt     DateTime?

  // Atribución de publicidad (Fase 1). null = "Sin atribuir".
  originChannel AttributionChannel?
  campaign      Campaign?           @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId    String?

  /// LO QUE PASÓ AL PRODUCIRLO (medición, 2026-09-07). Opcionales: se cargan al
  /// imprimir, no al tomar el pedido, y un pedido sin cargar NO es un pedido de
  /// cero fallos — es uno sin medir, y las cuentas lo excluyen.
  ///
  /// Las HORAS de máquina NO están acá: se llevan como lectura mensual del
  /// contador (`PrinterReading`), porque también se imprime fuera de los
  /// pedidos y eso gasta vida útil igual.
  printer   Printer? @relation(fields: [printerId], references: [id], onDelete: SetNull)
  printerId String?
  /// Piezas que hubo que volver a imprimir por fallo. Cero es un dato válido
  /// (se imprimió sin fallas); null es "no se midió".
  reprints  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments     Payment[]
  // Solicitud de tienda que dio origen a este pedido (si vino de ahí).
  storeRequest StoreRequest?

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, deliveryDate])
  @@index([campaignId])
}

// Abono/pago de un pedido. Monto en la moneda BASE de la organización (USD).
// Congela la tasa usada al momento del pago (Fase 2) para reconciliar en Bs: el
// saldo/total se muestran EN VIVO, pero cada abono conserva su equivalente en Bs.
model Payment {
  id             String   @id @default(cuid())
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId        String
  organizationId String // desnormalizado para scoping directo
  date           DateTime
  amount         Decimal  @db.Decimal(12, 4)
  note           String?
  // Tasa congelada al pagar (moneda destino por 1 USD) + su moneda/nombre. Null si
  // el pedido cobra solo en USD (sin moneda elegida).
  rate           Decimal? @db.Decimal(18, 6)
  currencyCode   String?
  currencyLabel  String?

  /// Mismo criterio que `Sale.source`: el abono importado del Excel lleva su
  /// insignia en el detalle de "Ventas cobradas".
  source RecordSource @default(MANUAL)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([organizationId])
}

// Producto: una pieza YA COSTEADA y reutilizable (Fase 4). Guarda el snapshot
// del CalcInput con el que se costeó, el precio de venta que fijó el dueño
// (`priceSet`) y el costo unitario al guardarlo (`costAtSave`, ancla del delta).
// El recosteo re-resuelve el CalcInput contra el catálogo de HOY (por nombre) y
// corre el motor; la alerta de rentabilidad es ese delta hecho aviso. Nunca se
// recostea silenciosamente: el dueño decide cuándo cambia el precio de venta.

// Tasas de cambio con NOMBRE (Fase 3 multi-moneda). Append-only: la fila más
// reciente por `label` es la vigente; el resto es histórico. La IDENTIDAD de una
// tasa es su `label` (ej. "Dólar BCV", "Euro neto"), no la moneda — puede haber
// dos tasas distintas de la misma moneda (BCV vs paralelo). `currencyCode` es la
// moneda DESTINO (para formatear) y `rate` = unidades de esa moneda por 1 USD
// (la base siempre es USD). El costeo y las estadísticas nunca dejan de ser USD.
model ExchangeRate {
  id             String             @id @default(cuid())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  label          String             @default("") // identidad de la tasa (nombre libre)
  currencyCode   String // ISO 4217 de la moneda destino, ej. "VES"
  rate           Decimal            @db.Decimal(18, 6)
  source         ExchangeRateSource @default(MANUAL)
  createdAt      DateTime           @default(now())

  @@index([organizationId, label, createdAt(sort: Desc)])
  @@index([organizationId, currencyCode, createdAt(sort: Desc)])
}

// Opción reutilizable de un campo de catálogo (lista administrada aparte): p. ej.
// marca / tipo / color de filamento. Vive por sí sola (persiste aunque no haya
// material que la use) y es editable. `kind` agrupa la lista (MATERIAL_BRAND…);
// `value` es la etiqueta libre. Única por (org, kind, value) para no duplicar.
model CatalogOption {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  kind           String // MATERIAL_BRAND | MATERIAL_TYPE | MATERIAL_COLOR (validado en la API)
  value          String
  createdAt      DateTime     @default(now())

  @@unique([organizationId, kind, value])
  @@index([organizationId, kind])
}

// ----- Publicidad / ROI (Fase 1) -----

enum CampaignPlatform {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  GOOGLE
  WHATSAPP
  OTHER
}

enum CampaignObjective {
  SALES
  MESSAGES
  VISITS
  FOLLOWERS
  AWARENESS
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  FINISHED
}

// Canal de origen para atribuir un documento (cotización/pedido/venta) a publicidad.
// null = "Sin atribuir". Un canal genérico O una campaña específica (campaignId).
enum AttributionChannel {
  ORGANIC
  // Pedido nacido en la TIENDA pública. Sin este valor los pedidos que llegan
  // del catálogo caen como "Sin atribuir" (o mienten como WHATSAPP) y quedan
  // fuera del ROI por campaña, que es justamente para lo que se construyó.
  STORE
  INSTAGRAM_ADS
  FACEBOOK_ADS
  TIKTOK_ADS
  GOOGLE_ADS
  WHATSAPP
  REFERRAL
  OTHER
}

// Campaña publicitaria. El "gastado real" NO se almacena: se DERIVA de los Expense
// enlazados (categoría ADVERTISING + campaignId), como el saldo de un pedido. El
// presupuesto es estimado (USD). Base siempre USD; el Bs del gasto se congela en el
// Expense. Aditivo: las ventas/cotizaciones/pedidos pueden existir sin campaña.
model Campaign {
  id             String             @id @default(cuid())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  platform       CampaignPlatform   @default(OTHER)
  objective      CampaignObjective?
  status         CampaignStatus     @default(ACTIVE)
  startDate      DateTime
  endDate        DateTime?
  budget         Decimal?           @db.Decimal(12, 4) // presupuesto estimado (USD)
  notes          String?

  /// Lo que reporta la plataforma. Son la ÚNICA medida de una campaña que
  /// todavía no generó una venta atribuida: sin ellas solo se la puede juzgar
  /// por ROAS, que en ese caso es cero y no dice nada.
  reach         Int? // personas alcanzadas
  conversations Int? // conversaciones iniciadas
  profileVisits Int? // visitas al perfil
  followers     Int? // seguidores ganados

  /// Venta atribuida DECLARADA (columna "Venta atribuida ($)" de la hoja
  /// Publicidad del Excel): lo vendido que se le rastrea a la campaña pero que
  /// nunca se registró pedido por pedido.
  ///
  /// ⚠️ NO es facturación: ya está contado dentro de las ventas del negocio.
  /// Vive acá, y no como Sale ni Order, justamente para que NO entre al ingreso.
  /// Entre el 2026-10-02 y el 2026-10-04 se la guardó como pedidos falsos
  /// ("Varios (historico sin detalle)") y la reposición de equipos pasó a decir
  /// que las impresoras habían devuelto $431,08 cuando el Excel decía $0.
  attributedSales Decimal  @default(0) @db.Decimal(12, 4)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  expenses Expense[]
  orders   Order[]
  sales    Sale[]

  @@index([organizationId])
}

// ----- Tienda (catálogo público) -----
//
// La FICHA DE TIENDA es un modelo aparte del `Product` interno a propósito: aquel
// responde "¿cuánto me cuesta y a cuánto lo vendo?" (snapshot del CalcInput,
// recosteo, alerta de margen) y esta responde "¿qué ve y compra el cliente?"
// (fotos, descripción, opciones, visibilidad). Fusionarlos haría que cada cambio
// de foto tocara el snapshot de costeo — y un SERVICIO no tiene CalcInput, así
// que ni siquiera cabría en `Product`, que exige `input` y `costAtSave`.

/**
 * Un producto físico (se imprime y se entrega) o un servicio (diseño, reparación).
 */
enum StoreProductKind {
  PHYSICAL
  SERVICE
}

/**
 * Agrupación de la vitrina ("Llaveros", "Figuras", "Servicios").
 */
model StoreCategory {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  slug           String
  position       Int          @default(0)
  createdAt      DateTime     @default(now())

  products StoreProduct[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model StoreProduct {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  /**
   * Identificador de la URL pública. Único por organización.
   */
  slug        String
  name        String
  kind        StoreProductKind @default(PHYSICAL)
  /**
   * Una línea para la tarjeta de la vitrina.
   */
  summary     String?
  /**
   * Texto largo de la ficha.
   */
  description String?

  // El precio de vitrina vive en USD (la base del motor); los bolívares son capa
  // de presentación y se calculan con la tasa vigente al mostrarlos.
  priceUsd     Decimal  @db.Decimal(12, 4)
  /**
   * Precio tachado, para ofertas. Solo presentación.
   */
  compareAtUsd Decimal? @db.Decimal(12, 4)

  /**
   * Días de producción a mostrar. Reemplaza al stock: se produce bajo pedido.
   */
  leadTimeDays Int?
  minQty       Int  @default(1)

  /// Material con el que se imprime ("PLA", "PETG"...). Texto libre: es una
  /// etiqueta de vitrina, no un enlace al catalogo interno de filamentos.
  material String?
  /// Insignia de esquina de la tarjeta ("Nuevo", "Mas vendido"). Texto libre.
  badge    String?
  /// Si el cliente puede pedirlo con su nombre, logo o forma.
  custom   Boolean @default(false)
  /// Ficha tecnica libre: [{ label, value }]. Un JSON en vez de una columna por
  /// dato, para no migrar cada vez que aparece una especificacion nueva.
  specs    Json    @default("[]")
  /**
   * false = borrador (no sale por la API pública).
   */
  visible  Boolean @default(false)
  /**
   * Orden manual en la vitrina.
   */
  position Int     @default(0)

  category   StoreCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId String?

  // ORIGEN DE COSTEO, opcional: enlaza la ficha con el producto interno o la
  // cotización de la que salió. Sirve para la alerta de rentabilidad; NUNCA sale
  // por la API pública. `SetNull` para que borrar el origen no borre la ficha.
  /// Costo unitario congelado al publicar (USD). Interno.
  costAtPublish Decimal? @db.Decimal(12, 4)

  /// Snapshot del `CalcInput` con el que se costeó la ficha, tal como lo dejó
  /// la calculadora. Es lo que permite el RECOSTEO: recalcular con los precios
  /// de hoy y avisar si el margen se cayó.
  ///
  /// **null es normal**, no un error: una ficha cargada a mano o un SERVICIO no
  /// tienen costeo. Que el costeo sea opcional acá —y obligatorio en el viejo
  /// `Product`— es justamente lo que permite un catálogo único.
  input Json?

  images       StoreImage[]
  optionGroups StoreOptionGroup[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([organizationId, visible])
  @@index([categoryId])
}

/**
 * Foto de una ficha. El archivo vive en R2; acá solo se guarda su clave.
 */
model StoreImage {
  id             String       @id @default(cuid())
  storeProduct   StoreProduct @relation(fields: [storeProductId], references: [id], onDelete: Cascade)
  storeProductId String
  /**
   * Clave del objeto en el bucket (no la URL: el dominio público es configurable).
   */
  key            String
  alt            String?
  width          Int?
  height         Int?
  position       Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([storeProductId])
}

// Opciones SIN combinatoria (no hay SKU por combinación): al producirse bajo
// pedido no existe stock que llevar por variante, así que una matriz sería peso
// muerto. El recargo por opción alcanza para "Grande cuesta $3 más".
model StoreOptionGroup {
  id             String       @id @default(cuid())
  storeProduct   StoreProduct @relation(fields: [storeProductId], references: [id], onDelete: Cascade)
  storeProductId String
  /**
   * "Color", "Tamaño", "Acabado".
   */
  name           String
  required       Boolean      @default(false)
  position       Int          @default(0)

  options StoreOption[]

  @@index([storeProductId])
}

model StoreOption {
  id            String           @id @default(cuid())
  group         StoreOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId       String
  /**
   * "Rojo", "Grande".
   */
  value         String
  /**
   * Recargo sobre el precio base, en USD (0 = sin recargo).
   */
  priceDeltaUsd Decimal          @default(0) @db.Decimal(12, 4)
  /**
   * Muestra de color para el selector (#RRGGBB). Solo si el grupo es de color.
   */
  swatchHex     String?
  position      Int              @default(0)

  @@index([groupId])
}

// ----- Bandeja de la tienda (lo que llega SIN sesión) -----

/**
 * Pedido del carrito (con líneas y total) o solicitud de pieza a medida.
 */
enum StoreRequestKind {
  ORDER
  CUSTOM
}

enum StoreRequestStatus {
  NEW
  CONFIRMED
  DISCARDED
}

/**
 * Lo que manda un visitante de la tienda. Es una BANDEJA, no un pedido: es la
 * primera escritura sin sesión del sistema, y nada de lo que entra por ahí toca
 * la operación ni el CRM hasta que el dueño lo confirma. Recién al confirmar se
 * crea (o se enlaza por teléfono) el `Client` y se crea el `Order`.
 * `lines` y `totalUsd` los calcula el SERVIDOR leyendo la ficha de tienda; el
 * cliente solo dice qué producto y qué opciones quiere. Si el precio viajara en
 * el cuerpo, cualquiera compraría a $0.01 y llegaría como venta legítima.
 * No se guarda IP ni user-agent: el rate limit ya frena el abuso, y almacenar
 * esos datos de desconocidos sería una responsabilidad sin uso para el dueño.
 */
model StoreRequest {
  id             String             @id @default(cuid())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  kind           StoreRequestKind
  status         StoreRequestStatus @default(NEW)

  customerName     String
  customerPhone    String
  // Teléfono normalizado (solo dígitos, 0 inicial -> 58) para enlazar con un
  // contacto existente sin depender de cómo lo escribió cada uno.
  customerPhoneKey String
  customerNote     String?

  // Solo ORDER: renglones [{ slug, name, quantity, options, unit, unitPrice }]
  // con el precio que calculó el servidor, y su total.
  lines    Json    @default("[]")
  totalUsd Decimal @default(0) @db.Decimal(12, 4)

  // Solo CUSTOM: qué pieza necesita.
  description String?

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?

  // Resultado de confirmar.
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId String?
  order    Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId  String? @unique

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([clientId])
}

/// PRÉSTAMO con el que se compró un equipo. El **saldo se DERIVA** (capital −
/// abonos), nunca se almacena, igual que el de un pedido.
///
/// Un pago de préstamo **no es un `Expense`**: el equipo ya entró al ledger como
/// inversión, y contar además cada cuota sería contar la misma máquina dos
/// veces. Devolver capital no es un costo.
model Loan {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  /// Lo prestado, en USD base.
  principal      Decimal      @db.Decimal(12, 4)
  /// Cuota mensual comprometida. Alimenta el nivel 2 del punto de equilibrio.
  monthlyPayment Decimal      @default(0) @db.Decimal(12, 4)
  startDate      DateTime?
  /// Fecha en que se terminó de pagar. null = abierto (y su cuota cuenta).
  closedAt       DateTime?
  notes          String?

  /// El equipo que se compró con el préstamo, si fue para uno.
  printer   Printer? @relation(fields: [printerId], references: [id], onDelete: SetNull)
  printerId String?

  /// QUIÉN prestó la plata. Nulable solo mientras dura la migración: el backfill
  /// lo completa y una migración posterior lo vuelve obligatorio. `name` es el
  /// concepto de la deuda ("Deuda impresora P2S"), no el acreedor.
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  counterpartyId String?

  /// Qué se financió, en palabras del dueño. Aparte de `name`, que es corto.
  concept String?

  /// El período de la CUOTA OBJETIVO (`monthlyPayment`). El punto de equilibrio
  /// la normaliza a mensual antes de sumarla: una cuota semanal de $50 no son
  /// $50 al mes.
  paymentFrequency PaymentFrequency @default(MONTHLY)

  /// Solo si el dueño la sabe. **No se inventa a partir de la frecuencia**: sin
  /// calendario pactado, una fecha calculada se leería como un compromiso que
  /// no existe.
  nextDueDate DateTime?

  payments  LoanPayment[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([organizationId])
}

model LoanPayment {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  loan           Loan         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  loanId         String

  date      DateTime
  amount    Decimal  @db.Decimal(12, 4)
  /// La referencia del pago (transferencia, "cena", lo que sea): es lo que
  /// permite reconciliar con el banco después.
  reference String?
  refundable Boolean      @default(true)
  source     RecordSource @default(MANUAL)

  debtApplications DebtApplication[]

  /// QUIÉN puso la plata de la cuota. `null` = la caja del negocio.
  ///
  /// Si la puso una persona, el negocio se la debe a ELLA: baja la deuda con el
  /// prestamista y sube la deuda con quien pagó, así que el total no cambia.
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  counterpartyId String?

  /// De qué cuenta salió. Opcional: hoy solo se concilia la principal.
  account   CashAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId String?

  /// Anular NO borra: el pago queda en el historial y el saldo se recalcula.
  /// Mismo patrón que `CashReconciliation`.
  voidedAt   DateTime?
  voidReason String?

  /// La parte que NO amortiza capital. Hoy siempre 0 y sin UI: el préstamo real
  /// no tiene intereses. Está para que el día que haya uno, el saldo no se
  /// calcule mal en silencio.
  interestAmount Decimal @default(0) @db.Decimal(12, 4)

  /// Lo que se pagó de verdad, si no fue en USD. Sin UI: el dueño paga en
  /// dólares. El saldo siempre se lleva en USD, como todo el motor.
  currency String?
  rate     Decimal? @db.Decimal(18, 6)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([loanId])
}

/// META MENSUAL (hoja "Metas" del Excel). Solo guarda lo que el dueño se
/// PROPONE; lo cumplido se DERIVA de las ventas, los pedidos y los clientes del
/// mes. Guardar lo real lo dejaría viejo en cuanto entre una venta.
///
/// `month` es el primer día del mes a medianoche UTC, igual que `StockCount`.
model Goal {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  month          DateTime

  salesTarget      Decimal @default(0) @db.Decimal(12, 4)
  ordersTarget     Int     @default(0)
  newClientsTarget Int     @default(0)
  notes            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, month])
  @@index([organizationId])
}

/// LECTURA MENSUAL DEL CONTADOR DE UNA IMPRESORA.
///
/// Se anota lo que MARCA la máquina al cierre del mes, igual que el conteo de
/// rollos: `hours` es acumulado, no las horas del mes. Las horas del mes se
/// DERIVAN restando la lectura anterior (`hoursThisMonth`), y si falta alguna
/// de las dos el consumo es "sin dato", no cero.
///
/// Vive acá y no en el pedido porque también se imprime fuera del negocio
/// —pruebas, calibraciones, regalos, tandas falladas— y eso gasta vida útil.
model PrinterReading {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  printer        Printer      @relation(fields: [printerId], references: [id], onDelete: Cascade)
  printerId      String
  /// Primer día del mes a medianoche UTC, igual que `StockCount`.
  month          DateTime
  /// Horas ACUMULADAS que muestra la máquina en ese cierre.
  hours          Decimal      @db.Decimal(12, 2)
  note           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([printerId, month])
  @@index([organizationId])
}

/// Movimiento entre el bolsillo del propietario y la caja del negocio que NO
/// es un gasto (ver `OwnerMovementKind`). Ej.: la regularización del
/// 17/09/2026.
model OwnerMovement {
  id             String            @id @default(cuid())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  date           DateTime
  kind           OwnerMovementKind
  amount         Decimal           @db.Decimal(12, 4)
  concept        String
  note           String?

  counterparty   Counterparty @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  counterpartyId String
  /// Un CONTRIBUTION con `refundable = false` es un aporte de capital.
  refundable     Boolean      @default(true)
  source         RecordSource @default(MANUAL)

  /// ⚠️ LA IDEMPOTENCIA: una conciliación genera UN solo ajuste.
  cashReconciliation   CashReconciliation? @relation(fields: [cashReconciliationId], references: [id], onDelete: Cascade)
  cashReconciliationId String?             @unique

  /// Las deudas que este pago canceló.
  applications    DebtApplication[] @relation("PaymentApplied")
  /// Si este movimiento ES una obligación (aporte reembolsable), lo que se le pagó.
  appliedPayments DebtApplication[] @relation("ObligationApplied")

  createdAt DateTime @default(now())

  @@index([organizationId, date])
}

/// CONTRAPARTE: el dueño, un socio o un prestamista externo. Existe para que
/// la deuda no cuelgue de un nombre fijo sino de "Le debe a <nombre>", y para
/// que un negocio con dos socios pueda llevar la deuda de cada uno por
/// separado.
model Counterparty {
  id             String           @id @default(cuid())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  name           String
  kind           CounterpartyKind
  /// La contraparte por defecto de la organización. Una sola (índice parcial
  /// creado a mano en la migración: Prisma no declara índices parciales).
  isDefault      Boolean          @default(false)
  active         Boolean          @default(true)
  notes          String?

  movements    OwnerMovement[]
  accounts     CashAccount[]
  loans        Loan[]
  expenses     Expense[]
  loanPayments LoanPayment[]
  /// Los abonos a facturas que puso esta contraparte de su bolsillo.
  purchasePayments PurchaseInvoicePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

/// CUENTA donde vive la plata. El modo "compartida" y la atribución automática
/// de faltantes son POR CUENTA: una caja de efectivo del negocio no se concilia
/// igual que un exchange mezclado con la plata personal del dueño.
model CashAccount {
  id                     String          @id @default(cuid())
  organization           Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId         String
  name                   String
  kind                   CashAccountKind @default(EXCHANGE)
  /// ISO 4217. Si no es USD, la conciliación exige tasa.
  currency               String          @default("USD")
  /// Mezcla plata del negocio con la personal de `sharedWith`.
  shared                 Boolean         @default(false)
  sharedWith             Counterparty?   @relation(fields: [sharedWithId], references: [id], onDelete: SetNull)
  sharedWithId           String?
  /// Al confirmar, un faltante se registra como salida hacia `sharedWith`.
  /// APAGADA por defecto: convierte un desconocido en una deuda saldada.
  autoAttributeShortfall Boolean         @default(false)
  active                 Boolean         @default(true)
  isDefault              Boolean         @default(false)

  reconciliations CashReconciliation[]
  loanPayments    LoanPayment[]
  purchasePayments PurchaseInvoicePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

/// CONCILIACIÓN DE CAJA (antes `CashCount`, "el conteo de los lunes").
///
/// Es un DOCUMENTO, no una vista: al confirmar congela los importes para que
/// una venta cargada tarde con fecha vieja no mueva el historial.
model CashReconciliation {
  id             String               @id @default(cuid())
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String
  account        CashAccount          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  accountId      String
  date           DateTime
  status         ReconciliationStatus @default(DRAFT)

  /// Lo contado, en la moneda de la cuenta.
  totalAmount    Decimal  @db.Decimal(12, 4)
  /// Componente personal DECLARADO. No se deriva: el dinero personal del dueño
  /// entra y sale por fuera del negocio y el sistema no lo ve.
  personalAmount Decimal  @default(0) @db.Decimal(12, 4)
  currency       String
  /// Mismo patrón que `Expense.rate` + `Expense.currencyCode`.
  rate           Decimal? @db.Decimal(18, 8)

  /// Congelados al confirmar.
  totalUsd      Decimal? @db.Decimal(12, 4)
  personalUsd   Decimal? @db.Decimal(12, 4)
  expectedUsd   Decimal? @db.Decimal(12, 4)
  /// `businessActualUsd − expectedUsd`. Negativo = falta plata del negocio.
  differenceUsd Decimal? @db.Decimal(12, 4)

  /// Otra explicación del descuadre, cuando no se atribuye a la contraparte.
  explanation String?
  note        String?
  source      RecordSource @default(MANUAL)

  confirmedAt       DateTime?
  confirmedByUser   User?     @relation(fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  confirmedByUserId String?
  voidedAt          DateTime?

  /// El ajuste que generó, si generó alguno.
  adjustment OwnerMovement?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, date])
  @@index([accountId])
}

/// Qué parte de un pago a la contraparte cancela qué obligación concreta.
///
/// Es lo ÚNICO que se guarda del reparto: el saldo de cada obligación se DERIVA
/// restándole sus aplicaciones, igual que el saldo de un préstamo.
model DebtApplication {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  /// ⚠️ DOS relaciones a `OwnerMovement` desde este modelo: las dos llevan
  /// nombre o Prisma no compila.
  payment   OwnerMovement @relation("PaymentApplied", fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId String

  /// La obligación cancelada: EXACTAMENTE UNA (CHECK en la migración).
  expense              Expense?       @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  expenseId            String?
  loanPayment          LoanPayment?   @relation(fields: [loanPaymentId], references: [id], onDelete: Cascade)
  loanPaymentId        String?
  obligationMovement   OwnerMovement? @relation("ObligationApplied", fields: [obligationMovementId], references: [id], onDelete: Cascade)
  obligationMovementId String?

  amount Decimal @db.Decimal(12, 4)

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([paymentId])
  @@index([expenseId])
  @@index([loanPaymentId])
  @@index([obligationMovementId])
}

/// FACTURA O ENCARGO DE COMPRA: lo que pediste y todavía no llegó, o llegó y
/// se pagó en cuotas. Solo para **filamento e impresoras** (decisión del dueño).
///
/// ⚠️ **Los abonos son la PLATA; la recepción es la MERCADERÍA.** Son dos
/// momentos distintos y esto los separa: el saldo de la caja baja cuando
/// abonás, el rollo entra al inventario cuando llega.
///
/// ⚠️ El total, lo pagado, lo que falta y si está recibida **se DERIVAN** de
/// las líneas y los abonos. Guardarlos los dejaría contradiciendo a sus partes
/// el día que alguien corrige una línea. Lo único que se guarda es `voidedAt`,
/// porque anular es una decisión, no un cálculo.
model PurchaseInvoice {
  id             String       @id @default(cuid())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId String

  /// A quién le comprás: un contacto del directorio con tipo SUPPLIER.
  supplier   Client? @relation("FacturasDelProveedor", fields: [supplierId], references: [id], onDelete: Restrict)
  supplierId String?

  /// Fecha de la factura o del encargo (fecha de NEGOCIO, medianoche UTC).
  date       DateTime
  /// Cuándo se espera que llegue. Es una expectativa, no un compromiso.
  expectedAt DateTime?
  /// Número de factura o del pedido, para reconciliar con el proveedor.
  reference  String?
  notes      String?

  /// Anular, no borrar: una factura con abonos movió plata de verdad.
  voidedAt   DateTime?
  voidReason String?

  lines    PurchaseInvoiceLine[]
  payments PurchaseInvoicePayment[]

  /// Los abonos (de OTRAS facturas) que se financiaron con el saldo a favor
  /// que dejó ESTA. Es el lado inverso de `tomadoDeFactura`.
  saldoAFavorUsado PurchaseInvoicePayment[] @relation("SaldoAFavorUsado")

  source    RecordSource @default(MANUAL)
  createdAt DateTime     @default(now())

  @@index([organizationId])
  @@index([organizationId, date])
}

/// Qué ficha nace al recibir una línea que pide algo que no está en el catálogo.
enum PurchaseLineNuevoTipo {
  MATERIAL
  PRINTER
}

/// Una línea de la factura: qué se pidió, cuánto y a qué precio.
model PurchaseInvoiceLine {
  id        String          @id @default(cuid())
  invoice   PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String

  /// Qué se compra: `materialId` **o** `printerId`, nunca los dos…
  material   Material? @relation(fields: [materialId], references: [id], onDelete: Restrict)
  materialId String?
  printer    Printer?  @relation(fields: [printerId], references: [id], onDelete: Restrict)
  printerId  String?
  /// …salvo que la ficha todavía NO EXISTA: un color que nunca compraste no
  /// tiene ficha hasta que llega. Entonces la línea lleva su nombre y la ficha
  /// nace al recibirla.
  nombreNuevo String?
  /// ⚠️ **QUÉ ficha nace.** `null` solo en una línea del catálogo. Sin esto la
  /// recepción creaba SIEMPRE un filamento, así que encargar una impresora
  /// nueva —el caso normal: una máquina nueva no está en el catálogo— dejaba un
  /// rollo llamado "Impresora A2". El contrato Zod lo exige con `nombreNuevo` y
  /// lo prohíbe sin él.
  nuevoTipo PurchaseLineNuevoTipo?

  quantity  Int
  unitPrice Decimal @db.Decimal(12, 4)

  /// Cuántos de esos ya llegaron. Nunca mayor que `quantity`: la guarda vive
  /// en el servicio, porque un CHECK no puede comparar contra otra columna
  /// calculada en el mismo momento.
  received Int @default(0)

  /// Los gastos que generó: uno por recepción (pueden ser varias parciales).
  expenses Expense[]

  @@index([invoiceId])
}

/// Un abono a la factura. **Esto es lo que mueve la caja.**
model PurchaseInvoicePayment {
  id             String          @id @default(cuid())
  invoice        PurchaseInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      String
  /// Desnormalizado para poder scopear sin pasar por la factura.
  organizationId String

  date   DateTime
  amount Decimal  @db.Decimal(12, 4)

  /// QUIÉN puso la plata. `null` = la caja del negocio; si no, el negocio se
  /// la debe a esa contraparte, igual que un gasto de su bolsillo.
  counterparty   Counterparty? @relation(fields: [counterpartyId], references: [id], onDelete: Restrict)
  counterpartyId String?

  /// De qué cuenta salió, si se sabe.
  account   CashAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  accountId String?

  /// ⚠️ **TOMADO DEL SALDO A FAVOR**: de qué factura del MISMO proveedor sale.
  ///
  /// Pagaste $100 de una factura de $85: esos $15 son plata tuya que el
  /// proveedor te debe, y así se usan en el próximo pedido. **Este abono NO
  /// mueve la caja** (`fromCredit` en el motor): la plata ya salió al pagar de
  /// más, y contarla otra vez es la misma doble carga que el gasto nacido de
  /// una factura, por la otra puerta.
  ///
  /// ⚠️ Lo único que se guarda es **de dónde sale**, que es un hecho. El saldo
  /// a favor se DERIVA (Σ pagado de más − Σ aplicado): nada almacenado que
  /// pueda contradecir a sus partes.
  ///
  /// `onDelete: Restrict`: borrar la factura que financió un abono dejaría ese
  /// abono sin respaldo y el saldo a favor saldría de la nada.
  tomadoDeFactura   PurchaseInvoice? @relation("SaldoAFavorUsado", fields: [tomadoDeFacturaId], references: [id], onDelete: Restrict)
  tomadoDeFacturaId String?

  note String?

  /// Anular, no borrar: igual que las cuotas del préstamo.
  voidedAt   DateTime?
  voidReason String?

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([organizationId])
  @@index([tomadoDeFacturaId])
}
